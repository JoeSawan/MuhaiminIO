import {
    Button,
    VerticalBox,
    HorizontalBox,
    Switch,
    Slider,
    TextEdit,
    ProgressIndicator,
} from "std-widgets.slint";
import "assets/DigitalNumbers-Regular.ttf";
import {
    ColorTheme,
    Typography,
    Spacing,
    BorderRadius,
    StyledButton,
    StyledCard,
    StyledLabel,
    StyledBadge,
    StyledAlert,
    StyledContainer,
} from "theme.slint";

export component MySlider inherits Rectangle {
    in-out property <float> maximum: 100;
    in-out property <float> minimum: 0;
    in-out property <float> pwm;
    callback pwm-changed();
    min-height: 8px;
    min-width: 255px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: root.height / 2;
    background: touch.pressed ? #eee : ColorTheme.neutral_color;
    border-width: 1px;

    // المستطيل الذي يعرض القيمة الحالية
    Rectangle {
        background: ColorTheme.secondary_color;
        height: parent.height;
        width: handle.x + (handle.width / 2);
        border-radius: parent.border-radius;
        x: 0;
        opacity: root.pwm / root.maximum;
    }

    handle := Rectangle {
        width: self.height;
        height: parent.height * 2.5;
        border-width: 3px;
        border-radius: self.height / 2;
        background: touch.pressed ? ColorTheme.secondary_color : touch.has-hover ? ColorTheme.secondary_color : ColorTheme.primary_color;
        x: (root.width - handle.width) * (root.pwm - root.minimum) / (root.maximum - root.minimum);
    }

    touch := TouchArea {
        property <float> pressed-pwm;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.pressed-pwm = root.pwm;
            }
        }
        moved => {
            if (self.enabled && self.pressed) {
                root.pwm = max(root.minimum, min(root.maximum,
                    self.pressed-pwm + (touch.mouse-x - touch.pressed-x) * (root.maximum - root.minimum) / (root.width - handle.width)));
                root.pwm-changed();
            }
        }
    }
}

// Connection panel component (dropdown + refresh + connect)
export component ConnectionPanel inherits Rectangle {
    in property <[string]> ports_list: [];
    in property <string> selected_port: "";
    callback refresh_ports();
    callback connect_port(string);
    min-height: 40px;
    background: transparent;
    HorizontalBox {
        spacing: 6px;

        // Dropdown simulation: a Text showing selected port and a button to open list
        selected_display := Text {
            text: root.selected_port == "" ? "Select port" : root.selected_port;
            width: 160px;
            vertical-alignment: center;
            color: ColorTheme.primary_color;
        }

        Button {
            text: "Refresh";
            clicked => {
                root.refresh_ports();
            }
        }

        Button {
            text: "Connect";
            clicked => {
                root.connect_port(root.selected_port);
            }
        }

        // Ports list info (detailed port selection will be in modal dialog)
        Text {
            text: "Ports available: " + (root.ports_list.length > 0 ? "Yes" : "Loading...");
            color: ColorTheme.neutral_color;
            font-size: 12px;
        }
    }
}

// Connection status bar - bottom of window
export component StatusBar inherits Rectangle {
    in property <bool> connected: false;
    in property <string> port_name: "";
    callback toggle_connection(string);
    height: 60px;
    background: ColorTheme.primary_color;
    HorizontalBox {
        spacing: 12px;
        padding: 8px;
        alignment: space-between;
        
        // ---- Port name display ----
        Text {
            text: root.connected ? ("Connected: " + root.port_name) : "Not connected";
            color: white;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        
        // ---- Connect/Disconnect toggle button ----
        Button {
            text: root.connected ? "Disconnect" : "Connect";
            width: 120px;
            clicked => {
                root.toggle_connection(root.port_name);
            }
        }
    }
}

export component Pins inherits Rectangle {
    // ========================================
    // COMPONENT DIMENSIONS
    // ========================================
    height: 50px;
    background: transparent;

    // ========================================
    // STYLE PROPERTIES
    // ========================================
    property <length> paddingm: 4px;
    property <length> spacing: 4px;
    property <string> font-family: "Roboto, sans-serif";
    property <length> font-size: 24px;
    in-out property <float> border-opacity: 1.0;

    // ========================================
    // MICROCONTROLLER CONFIGURATION
    // ========================================
    in property <string> mcu: "uno";
    in property <int> pwm_bit: 8;
    in property <int> adc_bit: 10;

    // ========================================
    // PIN CAPABILITIES & CONFIGURATION
    // ========================================
    in property <int> UID: 1;
    in property <int> pin: 1;
    in property <bool> is-pwm: false;
    in property <bool> is-AnalogRead: false;
    in property <bool> is-output: false;

    // ========================================
    // PIN STATE PROPERTIES
    // ========================================
    in property <bool> input: false;               // Digital input state: true = HIGH, false = LOW
    out property <bool> output: false;              // Digital output state: true = HIGH, false = LOW
    in property <int> analog: 0;                    // Analog read value (0-1023)
    out property <int> pwm: 0;                      // PWM output value
    in-out property <int> mods: 4;                  // Current mode: 1=PWM, 2=Analog, 3=Output, 4=Input, 5=InputPullup

    // ========================================
    // COMPUTED PROPERTIES & CONSTANTS
    // ========================================
    property <float> pwm_max: Math.pow(2, root.pwm_bit) - 1;
    property <float> adc_max: Math.pow(2, root.adc_bit) - 1;
    in-out property <float> maximum: pwm_max;
    in-out property <float> minimum: 0;

    // ========================================
    // MODE DESCRIPTIONS (Reference)
    // ========================================
    // Mode 1: PWM (Pulse Width Modulation) - requires is-pwm
    // Mode 2: Analog Read - requires is-AnalogRead
    // Mode 3: Digital Output - requires is-output
    // Mode 4: Digital Input - always available
    // Mode 5: Input Pullup - always available

    
//rotation-angle:
Rectangle {
        background: white;
        border-radius: 50px;
        HorizontalBox {
            spacing: 10px;
            padding: 0px;
            
            // ========================================
            // PIN LABEL DISPLAY
            // ========================================
            pin_label := Text {
                overflow: TextOverflow.elide;
                text: root.pin;
                font-family: is-AnalogRead ? "Roboto" : "Digital Numbers";
                width: 50px;
                height: 50px;
                horizontal-alignment: TextHorizontalAlignment.center;
                color: ColorTheme.primary_color;
                font-size: pin > 10 ? 30px : 36px;
                font-weight: 400;
                vertical-alignment: center;
            }

            // ========================================
            // MODE CONTENT & ANIMATION CONTAINER
            // ========================================
            mode_content_rect := Rectangle {
                height: 90px;
                min-width: 200px;
                
                // ---- Animation Properties ----
                property <float> mode_opacity: 1.0;
                property <float> mode_target_opacity: 1.0;
                property <int> pending_mods: root.mods;
                
                // ---- Mode Support Checker ----
                pure callback get-supported-mode(int) -> int;
                get-supported-mode(mode) => {
                    // Check the current mode and find the next available one
                    // 1: PWM, 2: Analog Read, 3: Digital Output, 4: Digital Input, 5: Input Pullup
                    if (mode == 1) {
                        if (root.is-pwm) {
                            return 1;
                        }
                        if (root.is-AnalogRead) {
                            return 2;
                        }
                        if (root.is-output) {
                            return 3;
                        }
                        return 4;
                    }
                    if (mode == 2) {
                        if (root.is-AnalogRead) {
                            return 2;
                        }
                        if (root.is-output) {
                            return 3;
                        }
                        return 4;
                    }
                    if (mode == 3) {
                        if (root.is-output) {
                            return 3;
                        }
                        return 4;
                    }
                    if (mode == 4) {
                        return 4;
                    }
                    if (mode == 5) {
                        return 5;
                    }
                    return 4;
                }
                
                // ---- Fade Trigger Callback ----
                callback do_fade();
                do-fade => {
                    if (!mode_timer.running) {
                        mode_target_opacity = 0.0;
                        mode_timer.running = true;
                    }
                }
                
                // ---- Mode Transition Timer ----
                mode_timer := Timer {
                    interval: 10ms;
                    running: false;
                    triggered => {
                        mode_opacity = mode_opacity + (mode_target_opacity - mode_opacity) * 0.3;
                        if (Math.abs(mode_target_opacity - mode_opacity) < 0.01) {
                            mode_opacity = mode_target_opacity;
                            if (mode_target_opacity == 0.0) {
                                // Switch mode while invisible, auto-skip unsupported modes
                                root.mods = mode_content_rect.get-supported-mode(pending_mods);
                                mode_target_opacity = 1.0;
                            } else {
                                mode_timer.running = false;
                            }
                        }
                    }
                }

                opacity: mode_opacity;
                
                // ========================================
                // MODE 1: PWM (Pulse Width Modulation)
                // ========================================
                if root.mods == 1:
                VerticalBox {
                    spacing: root.is-AnalogRead ? 10px : 0px;
                    padding: 0px;
                    HorizontalLayout {
                        Rectangle { }

                        Text {  //PWM
                            y: 0px;
                            text: "\{round(root.pwm)}";
                            color: ColorTheme.secondary_color;
                            height: 24px;
                            font-size: 20px;
                            font-family: "Digital Numbers";
                            font-weight: 400;
                            horizontal-alignment: TextHorizontalAlignment.center;
                        }

                        Rectangle { }
                    }

                    alignment: start;
                    slider := MySlider {
                        pwm: root.pwm;
                        minimum: root.minimum;
                        maximum: root.pwm_max;
                        pwm-changed => {
                            root.pwm = slider.pwm;
                        }
                    }
                }
                
                // ========================================
                // MODE 2: Analog Read (ADC)
                // ========================================
                if root.mods == 2:
                    VerticalBox {
                    y: 0px;
                    padding: 0px;
                    spacing: 0px;
                    Text {
                        color: ColorTheme.secondary_color;
                        font-family: "Roboto";
                        height: 28px;
                        font-size: 24px;
                        horizontal-alignment: center;
                        text: root.analog;
                    }

                    Rectangle {
                        width: 100%;
                        height: 20px;
                        background: ColorTheme.neutral_color;
                        border-radius: 10px;
                        Rectangle {
                            width: parent.width * (root.analog / 1023.0);
                            x: 1px;
                            height: 18px;
                            background: ColorTheme.secondary_color;
                            border-radius: 9px;
                        }
                    }
                }
                
                // ========================================
                // MODE 3: Digital Output
                // ========================================
                if root.mods == 3:
                Rectangle {
                    height: 36px;
                    width: 72px;
                    y: 7px;
                    border-radius: self.height / 2;
                    background: root.output ? ColorTheme.secondary_color : ColorTheme.neutral_color;
                    // knob position animation (timer-driven).
                    // Avoid binding knob_x to root.output so the knob doesn't jump on the first click.
                    property <length> knob_x: 5px;
                    property <length> knob_target: knob_x;

                    // one-shot initializer to set the initial knob position according to root.output
                    init_timer := Timer {
                        interval: 1ms;
                        running: true;
                        triggered => {
                            knob_x = root.output ? 40px : 5px;
                            knob_target = knob_x;
                            init_timer.running = false;
                        }
                    }

                    knob_timer := Timer {
                        interval: 4ms;
                        running: false;
                        triggered => {
                            // interpolate towards target (simple easing)
                            knob_x = knob_x + (knob_target - knob_x) * 0.25;
                            if (Math.abs(knob_target - knob_x) < 0.5px) {
                                knob_x = knob_target;
                                knob_timer.running = false;
                            }
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: self.height / 2;
                        y: 4px;
                        x: knob_x;
                        background: root.output ? ColorTheme.primary_color : ColorTheme.secondary_color;
                    }

                    TouchArea {
                        clicked => {
                            // toggle state
                            root.output = !root.output;
                            // update animation target and start timer
                            knob_target = root.output ? 40px : 5px;
                            knob_timer.running = true;
                        }
                    }
                }
                
                // ========================================
                // MODE 4 & 5: Digital Input / Input Pullup
                // ========================================
                if root.mods >= 4:
                 Rectangle {
                    height: 38px;
                    width: 38px;
                    y: 6px;
                    border-radius: self.height / 2;
                    background: root.input ? ColorTheme.secondary_color : ColorTheme.neutral_color;
                }
            }

            // ========================================
            // MODE SELECTOR TOUCH AREA & ICONS
            // ========================================
            TouchArea {
                height: 50px;
                width: 50px;
                
                // ---- Visual Feedback Backgrounds ----
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    border-width: 5px;
                    border-color: root.input ? ColorTheme.secondary_color : ColorTheme.neutral_color;
                    background: transparent;
                    opacity: root.mods == 1 ? root.pwm / root.pwm_max : (root.mods == 2 ? root.analog / root.adc_max : 1.0);
                }

                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    border-width: 5px;
                    border-color: ColorTheme.secondary_color;
                    background: transparent;
                    opacity: root.mods == 1 ? root.pwm / root.pwm_max : (root.mods == 2 ? root.analog / root.adc_max : 0.0);
                }
                
                // ---- Mode Cycling Handler ----
                clicked => {
                    mode_content_rect.pending_mods = Math.mod(root.mods, 5) + 1;
                    mode_content_rect.do_fade();
                }
                
                // ---- Mode Icons ----
                if root.mods == 1:
                Image {
                    source: @image-url("assets/pwm.svg");
                }
                if root.mods == 2:
                Image {
                    source: @image-url("assets/arw.svg");
                    transform-rotation: (root.analog / root.adc_max) * 240deg - 120deg;
                    vertical-alignment: ImageVerticalAlignment.center;
                    vertical-tiling: ImageTiling.round;
                    x: 20px;
                    y: -6px;
                }
                if root.mods == 2:
                Image {
                    source: @image-url("assets/Vector.svg");
                    y: 30px;
                }
                if root.mods == 3:
                Image {
                    source: @image-url("assets/output.svg");
                }
                if root.mods == 4:
                Image {
                    source: @image-url("assets/input.svg");
                }
                if root.mods == 5:
                Image {
                    source: @image-url("assets/input_pullup.svg");
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    width: 600px;
    height: 600px;
    background: ColorTheme.neutral_color;

    // Callbacks to be implemented in Rust
    callback connect(string);
    callback disconnect();
    callback list_ports();
    callback send_pwm(int, int);
    callback request_analog(int);

    // Connection state provided by backend
    in-out property <bool> connected: false;
    in-out property <string> connected_port: "";
    in-out property <[string]> available_ports: [];

    // local UI state
    property <bool> show_connection_dialog: false;
    VerticalBox {
        spacing: 0px;
        padding: 0px;

        // ========================================
        // MAIN CONTENT AREA
        // ========================================
        Rectangle {
            background: transparent;
            vertical-stretch: 1;
            VerticalBox {
                spacing: 8px;
                padding: 6px;
                Pins {
                    pin: 1;
                    is-AnalogRead: true;
                }

                Pins {
                    pin: 2;
                    is-AnalogRead: true;
                }

                Pins {
                    pin: 3;
                    is-AnalogRead: false;
                    is-output: true;
                    is-pwm: true;
                }

                Pins {
                    pin: 4;
                    is-pwm: true;
                    is-output: true;
                }

                Pins {
                    pin: 5;
                    is-AnalogRead: true;
                }

                Pins {
                    pin: 6;
                    is-AnalogRead: true;
                    Rectangle {
                        min-width: 16px;
                        min-height: 16px;
                    }
                }
            }
        }

        // ========================================
        // STATUS BAR (FOOTER)
        // ========================================
        StatusBar {
            connected: root.connected;
            port_name: root.connected_port;
            toggle_connection => {
                if (root.connected) {
                    root.disconnect();
                } else {
                    root.show_connection_dialog = true;
                    root.list_ports();
                }
            }
        }
    }

    // ========================================
    // CONNECTION DIALOG (MODAL)
    // ========================================
    Rectangle {
        visible: root.show_connection_dialog;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.45);
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.show_connection_dialog = false;
            }
        }

        // Centered dialog
        Rectangle {
            width: 594px;
            height: 595px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: white;
            VerticalBox {
                width: 100%;
                height: 100%;
                padding: 12px;
                conn := ConnectionPanel {
                    ports_list: root.available_ports;
                    selected_port: root.connected_port;
                    refresh_ports => root.list_ports();
                    connect_port => {
                        root.connect(conn.selected_port);
                        root.show_connection_dialog = false;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    Button {
                        text: "Close";
                        clicked => {
                            root.show_connection_dialog = false;
                        }
                    }
                }
            }
        }
    }
}
