import {
    VerticalBox,
    HorizontalBox,
    Button,
} from "std-widgets.slint";
import "assets/DigitalNumbers-Regular.ttf";
import { ColorTheme } from "theme.slint";
import { ToggleSwitch, Slider } from "components.slint";



export component Pins inherits Rectangle {
    // ========================================
    // COMPONENT DIMENSIONS
    // ========================================
    height: 50px;
    background: transparent;

    // ========================================
    // STYLE PROPERTIES
    // ========================================
    property <length> paddingm: 4px;
    property <length> spacing: 4px;
    property <string> font-family: "Roboto, sans-serif";
    property <length> font-size: 24px;
    in-out property <float> border-opacity: 1.0;

    // ========================================
    // MICROCONTROLLER CONFIGURATION
    // ========================================
    in property <string> mcu: "uno";
    in property <int> pwm_bit: 8;
    in property <int> adc_bit: 10;

    // ========================================
    // PIN CAPABILITIES & CONFIGURATION
    // ========================================
    in property <int> UID: 1;
    in property <int> pin: 1;
    in property <bool> is-pwm: false;
    in property <bool> is-AnalogRead: false;
    in property <bool> is-output: true;

    // ========================================
    // PIN STATE PROPERTIES
    // ========================================
    in property <bool> input: false;               // Digital input state: true = HIGH, false = LOW
    out property <bool> output: false;              // Digital output state: true = HIGH, false = LOW
    in property <int> analog: 512;                    // Analog read value (0-1023)
    out property <int> pwm: 0;                      // PWM output value
    in-out property <int> mods: 4;                  // Current mode: 1=PWM, 2=Analog, 3=Output, 4=Input, 5=InputPullup

    // ========================================
    // COMPUTED PROPERTIES & CONSTANTS
    // ========================================
    property <float> pwm_max: Math.pow(2, root.pwm_bit) - 1;
    property <float> adc_max: Math.pow(2, root.adc_bit) - 1;
    in-out property <float> maximum: pwm_max;
    in-out property <float> minimum: 0;

    // ========================================
    // MODE DESCRIPTIONS (Reference)
    // ========================================
    // Mode 1: PWM (Pulse Width Modulation) - requires is-pwm
    // Mode 2: Analog Read - requires is-AnalogRead
    // Mode 3: Digital Output - requires is-output
    // Mode 4: Digital Input - always available
    // Mode 5: Input Pullup - always available

    //rotation-angle:
    Rectangle {
        background: white;
        border-radius: 50px;
        HorizontalBox {
            spacing: 10px;
            padding: 0px;
            
            // ========================================
            // PIN LABEL DISPLAY
            // ========================================
            pin_label := Text {
                overflow: TextOverflow.elide;
                text: root.pin;
                font-family: is-AnalogRead ? "Roboto" : "Digital Numbers";
                width: 50px;
                height: 50px;
                horizontal-alignment: TextHorizontalAlignment.center;
                color: ColorTheme.primary_color;
                font-size: pin > 10 ? 30px : 36px;
                font-weight: 400;
                vertical-alignment: center;
            }

            // ========================================
            // MODE CONTENT & ANIMATION CONTAINER
            // ========================================
            mode_content_rect := Rectangle {
                height: 90px;
                min-width: 200px;
                
                // ---- Animation Properties ----
                property <float> mode_opacity: 1.0;
                property <float> mode_target_opacity: 1.0;
                property <int> pending_mods: root.mods;
                
                // ---- Mode Support Checker ----
                pure callback get-supported-mode(int) -> int;
                get-supported-mode(mode) => {
                    // Check the current mode and find the next available one
                    // 1: PWM, 2: Analog Read, 3: Digital Output, 4: Digital Input, 5: Input Pullup
                    if (mode == 1) {
                        if (root.is-pwm) {
                            return 1;
                        }
                        if (root.is-AnalogRead) {
                            return 2;
                        }
                        if (root.is-output) {
                            return 3;
                        }
                        return 4;
                    }
                    if (mode == 2) {
                        if (root.is-AnalogRead) {
                            return 2;
                        }
                        if (root.is-output) {
                            return 3;
                        }
                        return 4;
                    }
                    if (mode == 3) {
                        if (root.is-output) {
                            return 3;
                        }
                        return 4;
                    }
                    if (mode == 4) {
                        return 4;
                    }
                    if (mode == 5) {
                        return 5;
                    }
                    return 4;
                }
                
                // ---- Fade Trigger Callback ----
                callback do_fade();
                do-fade => {
                    if (!mode_timer.running) {
                        mode_target_opacity = 0.0;
                        mode_timer.running = true;
                    }
                }
                
                // ---- Mode Transition Timer ----
                mode_timer := Timer {
                    interval: 10ms;
                    running: false;
                    triggered => {
                        mode_opacity = mode_opacity + (mode_target_opacity - mode_opacity) * 0.3;
                        if (Math.abs(mode_target_opacity - mode_opacity) < 0.01) {
                            mode_opacity = mode_target_opacity;
                            if (mode_target_opacity == 0.0) {
                                // Switch mode while invisible, auto-skip unsupported modes
                                root.mods = mode_content_rect.get-supported-mode(pending_mods);
                                mode_target_opacity = 1.0;
                            } else {
                                mode_timer.running = false;
                            }
                        }
                    }
                }

                opacity: mode_opacity;
                
                // ========================================
                // MODE 1: PWM (Pulse Width Modulation)
                // ========================================
                if root.mods == 1:
                VerticalBox {
                    spacing: root.is-AnalogRead ? 10px : 0px;
                    padding: 0px;
                    HorizontalLayout {
                        Rectangle { }

                        Text {  //PWM
                            y: 0px;
                            text: "\{round(root.pwm)}";
                            color: ColorTheme.secondary_color;
                            height: 24px;
                            font-size: 20px;
                            font-family: "Digital Numbers";
                            font-weight: 400;
                            horizontal-alignment: TextHorizontalAlignment.center;
                        }

                        Rectangle { }
                    }

                    alignment: start;
                    slider := Slider {
                        value: root.pwm;
                        minimum: root.minimum;
                        maximum: root.pwm_max;
                        value-changed => {
                            root.pwm = slider.value;
                        }
                    }
                }
                
                // ========================================
                // MODE 2: Analog Read (ADC)
                // ========================================
                if root.mods == 2:
                    VerticalBox {
                    y: 0px;
                    padding: 0px;
                    spacing: 0px;
                    Text {
                        color: ColorTheme.secondary_color;
                        font-family: "Roboto";
                        height: 28px;
                        font-size: 24px;
                        horizontal-alignment: center;
                        text: root.analog;
                    }

                    Rectangle {
                        width: 100%;
                        height: 20px;
                        background: ColorTheme.neutral_color;
                        border-radius: 10px;
                        Rectangle {
                            width: parent.width * (root.analog / 1023.0);
                            x: 1px;
                            height: 18px;
                            background: ColorTheme.secondary_color;
                            border-radius: 9px;
                        }
                    }
                }
                
                // ========================================
                // MODE 3: Digital Output
                // ========================================
                if root.mods == 3:
                Rectangle {
                    height: 36px;
                    width: 72px;
                    y: 7px;
                    ToggleSwitch { }
                }
                
                // ========================================
                // MODE 4 & 5: Digital Input / Input Pullup
                // ========================================
                if root.mods >= 4:
                 Rectangle {
                    height: 38px;
                    width: 38px;
                    y: 6px;
                    border-radius: self.height / 2;
                    background: root.input ? ColorTheme.secondary_color : ColorTheme.neutral_color;
                }
            }

            // ========================================
            // MODE SELECTOR TOUCH AREA & ICONS
            // ========================================
            TouchArea {
                height: 50px;
                width: 50px;
                
                // ---- Visual Feedback Backgrounds ----
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    border-width: 5px;
                    border-color: root.input ? ColorTheme.secondary_color : ColorTheme.neutral_color;
                    background: transparent;
                    opacity: root.mods == 1 ? root.pwm / root.pwm_max : (root.mods == 2 ? root.analog / root.adc_max : 1.0);
                }

                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    border-width: 5px;
                    border-color: ColorTheme.secondary_color;
                    background: transparent;
                    opacity: root.mods == 1 ? root.pwm / root.pwm_max : (root.mods == 2 ? root.analog / root.adc_max : 0.0);
                }
                
                // ---- Mode Cycling Handler ----
                clicked => {
                    mode_content_rect.pending_mods = Math.mod(root.mods, 5) + 1;
                    mode_content_rect.do_fade();
                }
                
                // ---- Mode Icons ----
                if root.mods == 1:
                Image {
                    source: @image-url("assets/pwm.svg");
                }
                if root.mods == 2:
                Image {
                    source: @image-url("assets/arw.svg");
                    transform-rotation: (root.analog / root.adc_max) * 240deg - 120deg;
                    vertical-alignment: ImageVerticalAlignment.center;
                    vertical-tiling: ImageTiling.round;
                    x: 20px;
                    y: -6px;
                }
                if root.mods == 2:
                Image {
                    source: @image-url("assets/Vector.svg");
                    y: 30px;
                }
                if root.mods == 3:
                Image {
                    source: @image-url("assets/output.svg");
                }
                if root.mods == 4:
                Image {
                    source: @image-url("assets/input.svg");
                }
                if root.mods == 5:
                Image {
                    source: @image-url("assets/input_pullup.svg");
                }
            }
        }
    }
}

export component MCU inherits Rectangle {
    in property <string> name:"unknown";
    in property <int> pwm_bit: 8;
    in property <int> adc_bit: 10;

    // نموذج لخصائص كل Pin رقمية مثل Arduino Uno
    // is_pwm: البنات 3,5,6,9,10,11 فقط
    in property <[{
        pin: int,
        is_pwm: bool,
        is_analog: bool,
        is-output: bool,
    }]> pins: [
        { pin: 0, is-output:true, is_pwm: false, is_analog: false },
        { pin: 1, is-output:true, is_pwm: false, is_analog: false },
        { pin: 2, is-output:true, is_pwm: false, is_analog: false },
        { pin: 3, is-output:true, is_pwm: true, is_analog: false },
        { pin: 4, is-output:true, is_pwm: false, is_analog: false },
        { pin: 5, is-output:true, is_pwm: true, is_analog: false },
        { pin: 6, is-output:true, is_pwm: true, is_analog: false },
        { pin: 7, is-output:true, is_pwm: false, is_analog: false },
        { pin: 8, is-output:true, is_pwm: false, is_analog: false },
        { pin: 9, is-output:true, is_pwm: true, is_analog: false },
        { pin: 10, is-output:true, is_pwm: true, is_analog: false },
        { pin: 11, is-output:true, is_pwm: true, is_analog: false },
        { pin: 12, is-output:true, is_pwm: false, is_analog: false },
        { pin: 13, is-output:true, is_pwm: false, is_analog: false },
        { pin: 0, is-output:false, is_pwm: false, is_analog: true },
        { pin: 1, is-output:false, is_pwm: false, is_analog: true },
        { pin: 2, is-output:false, is_pwm: false, is_analog: true },
        { pin: 3, is-output:false, is_pwm: false, is_analog: true },
        { pin: 4, is-output:false, is_pwm: false, is_analog: true },
        { pin: 5, is-output:false, is_pwm: false, is_analog: true },
    ];
    min-width: 400px;
    min-height: 600px;
    background: ColorTheme.neutral_color;
    VerticalBox {
        spacing: 0px;
        padding: 0px;
        Rectangle {
            background: transparent;
            vertical-stretch: 1;
            VerticalBox {
                spacing: 8px;
                padding: 6px;
    // توليد 14 Pin رقمية تلقائيًا باستخدام for
    for p in pins: Pins {
        // index تلقائي من الـ model
        UID: p.pin;
                    pin: p.pin;
                    is-pwm: p.is_pwm;
                    is-AnalogRead: p.is_analog;
                    pwm_bit: root.pwm_bit;
                    adc_bit: root.adc_bit;
                }

    // توليد البنات التماثلية A0..A5 تلقائيًا
   
}
        }
    }
}

export component MainWindow inherits Window {
    min-width: 400px;
    min-height: 600px;
    background: ColorTheme.neutral_color;

    /* Connection state provided by backend
    in-out property <bool> connected: false;
    in-out property <string> connected_port: "";
    in-out property <[string]> available_ports: [];
    */
    // local UI state
    //  property <bool> show_connection_dialog: false;
    VerticalBox {
        MCU { }

        HorizontalBox {
            alignment: LayoutAlignment.space-around;
            Rectangle {
                background: ColorTheme.secondary_color;
                max-height: 80px;
                min-height: 40px;
                Button {
                    text: "cleck";
                }

                Text {
                    text: "test";
                }
            }
        }
    }
}
